<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/check_camera_alerts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="48dp"
            android:text="@string/camera_alerts" />

        <CheckBox
            android:id="@+id/check_avoid_areas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/avoid_areas" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/official_city_code"
            android:textColor="@color/text_primary" />

        <EditText
            android:id="@+id/edit_city_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/official_city_code_hint"
            android:inputType="text"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/api_base_url"
            android:textColor="@color/text_primary" />

        <EditText
            android:id="@+id/edit_api_base_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/api_base_url_hint"
            android:inputType="textUri"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/radius_override"
            android:textColor="@color/text_primary" />

        <EditText
            android:id="@+id/edit_radius_override"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/radius_override_hint"
            android:inputType="numberDecimal"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/button_save_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="48dp"
            android:text="@string/save_settings" />

        <TextView
            android:id="@+id/text_settings_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
